public class SumOfArray {
    public static void main(String[] args) {
        int[] numbers = {5, 7, 2, 0, 0, 5};
        int sum = 0;

        for (int i = 0; i < numbers.length; i++) {
            sum += numbers[i];
        }
        
        System.out.println("The sum of the array is: " + sum);
    }
}
